# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.

# API key Groq (https://console.groq.com/keys) - wajib bila LLM diaktifkan
GROQ_API_KEY=

# Akun admin pertama. Hanya dipakai saat database dibuat; setelah itu ganti lewat menu Akun.
# Bila ADMIN_PASSWORD kosong, password acak dicetak di konsol.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Kunci penanda sesi login. Bila kosong dibuat otomatis di instance/secret_key.
SECRET_KEY=

# Isi 1 bila situs diakses lewat HTTPS
COOKIE_SECURE=0

# Isi 1 saat development agar server otomatis restart setiap kode berubah
FLASK_RELOAD=0
